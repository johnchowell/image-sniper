# Working directory (worlds generated by skills)
worlds/*
!worlds/.gitkeep

# Input staging area
input/*
!input/.gitkeep

# App build output
node_modules/
app/dist/
app/node_modules/
app/.vite/

# Environment
.env

# OS
.DS_Store

# Local model runtime
.venv
.venv-render
third_party/
# Benchmark: renders and downloaded assets are rebuilt by .claude/scripts/bench/run_all.sh; results and the
# asset manifest are tracked so every reported number can be checked.
benchmark/*
!benchmark/results/
!benchmark/assets/
benchmark/assets/*
!benchmark/assets/manifest.json

# Python bytecode
__pycache__/
.venv.lock
.venv-setup.log
